# BLIS installs no pkg-config file, so anything that locates BLAS the standard
# way -- meson's dependency('blis') among them, which is how scipy finds it --
# cannot see it. Generate one at install time.
#
# The zoslib link flags go in Libs rather than behind "Requires.private: zoslib"
# for two reasons. libblis.a is a static archive, so every consumer needs them,
# not just static links. And naming zoslib as a requirement drags in its Cflags
# too, which are C-specific: a Fortran consumer then gets -isystem and
# -include <header>.h passed to a compiler that rejects both.
# BLIS already installs its own blis.pc into share/pkgconfig, but its Libs line
# stops at -lblis. libblis.a is static and references zoslib, so every consumer
# gets __zoslib_malloc/__zoslib_free/__pthread_create_extended UNRESOLVED at
# bind time -- which is what meson's dependency('blis') produces for scipy.
# Augment the file that is already there rather than adding a second one on
# PKG_CONFIG_PATH.
#
# The tagging either side of sed is deliberate. The file is ASCII; sed is an
# EBCDIC program, so it reads through the tag and writes EBCDIC. Declaring each
# encoding truthfully at each step is what keeps the result readable -- an
# earlier attempt to generate this file from a heredoc produced bytes that were
# neither ASCII nor EBCDIC, because the buildenv is itself ASCII-tagged and the
# content was converted on the way in and again on the way out.
# BLIS installs its own blis.pc into share/pkgconfig and zopen relocates it
# correctly. What it lacks is the zoslib libraries: its Libs line stops at
# -lblis, but libblis.a is static and references zoslib, so every consumer gets
# __zoslib_malloc and friends UNRESOLVED at bind time -- which is what meson's
# dependency('blis') hands scipy. Augment the file that is already there.
#
# The rewrite is done by Python reading and writing bytes, with the code and the
# values passed as argv. Nothing here goes through a heredoc or a shell
# redirection, because both are transcoded: this buildenv is ASCII-tagged, the
# shell reads it as EBCDIC, and _TAG_REDIR_OUT (exported by check_python) tags
# redirections -- earlier attempts using either produced a file that was neither
# ASCII nor EBCDIC and that pkg-config rejected with "has no Name: field".
zopen_post_install() {
  _blis_pc="${ZOPEN_INSTALL_DIR}/share/pkgconfig/blis.pc"
  [ -f "${_blis_pc}" ] || _blis_pc="${ZOPEN_INSTALL_DIR}/lib/pkgconfig/blis.pc"
  [ -f "${_blis_pc}" ] || printError "BLIS installed no blis.pc to augment"

  python3 -c 'import sys
pc, zl = sys.argv[1], sys.argv[2]
extra = " -L%s -lzoslib %s/celquopt.s.o -lzoslib-supp" % (zl, zl)
lines = open(pc, "rb").read().split(b"\n")
out = [l + extra.encode("iso8859-1") if l.startswith(b"Libs:") else l for l in lines]
open(pc, "wb").write(b"\n".join(out))
' "${_blis_pc}" "ZOPEN_INSTALL_PREFIX/zoslib/zoslib/lib" \
    || printError "could not augment blis.pc"

  # Assert it parses. A mis-encoded .pc is still a file, and the failure would
  # otherwise surface only in a consumer's build.
  PKG_CONFIG_PATH="$(dirname "${_blis_pc}")" pkg-config --exists blis \
    || printError "blis.pc is not readable by pkg-config after augmenting it"
  printInfo "- blis.pc: $(PKG_CONFIG_PATH="$(dirname "${_blis_pc}")" pkg-config --libs blis)"
}

zopen_append_to_env() {
cat <<ZZ
if [ ! -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
  export ZOPEN_EXTRA_CFLAGS="\${ZOPEN_EXTRA_CFLAGS} -I\$PWD/include"
  export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS}	-I\$PWD/include"
  export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\$PWD/lib"
  export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} -lblis"
fi
ZZ
}

