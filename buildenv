# BLIS installs no pkg-config file, so anything that locates BLAS the standard
# way -- meson's dependency('blis') among them, which is how scipy finds it --
# cannot see it. Generate one at install time.
#
# The zoslib link flags go in Libs rather than behind "Requires.private: zoslib"
# for two reasons. libblis.a is a static archive, so every consumer needs them,
# not just static links. And naming zoslib as a requirement drags in its Cflags
# too, which are C-specific: a Fortran consumer then gets -isystem and
# -include <header>.h passed to a compiler that rejects both.
zopen_post_install() {
  mkdir -p "${ZOPEN_INSTALL_DIR}/lib/pkgconfig"

  # Every path here is relative to the .pc file's own location, and the file
  # therefore contains no absolute install prefix. That matters for more than
  # tidiness: zopen-build rewrites any installed file that mentions the install
  # prefix, and that rewrite is "sed ... > file". check_python is a dependency
  # of this port and exports _TAG_REDIR_OUT=txt, which tags redirections, so the
  # rewrite re-encodes the file and leaves it readable by nothing -- Build 181
  # and 182 both shipped a blis.pc that pkg-config rejected with
  # "has no Name: field". Keeping the prefix out of the file sidesteps the
  # rewrite entirely, and makes the package properly relocatable besides.
  #
  # Written by Python rather than a heredoc for the same underlying reason:
  # redirection tagging would otherwise decide the file's encoding.
  python3 - "${ZOPEN_INSTALL_DIR}/lib/pkgconfig/blis.pc" "${BLIS_VERSION}" <<'PCEOF'
import sys
out, version = sys.argv[1], sys.argv[2]
text = (
    "prefix=${pcfiledir}/../..\n"
    "libdir=${prefix}/lib\n"
    "includedir=${prefix}/include\n"
    # zoslib sits alongside this port under the same zopen root.
    "zoslibdir=${pcfiledir}/../../../../zoslib/zoslib/lib\n"
    "\n"
    "Name: BLIS\n"
    "Description: BLAS-like Library Instantiation Software Framework\n"
    "Version: %s\n"
    # libblis.a is static and references zoslib, so every consumer needs these.
    # They are in Libs rather than behind Requires.private: naming zoslib would
    # also drag in its C-specific Cflags, which a Fortran consumer's compiler
    # rejects (-isystem, -include <header>.h).
    "Libs: -L${libdir} -lblis -L${zoslibdir} -lzoslib ${zoslibdir}/celquopt.s.o -lzoslib-supp\n"
    "Cflags: -I${includedir}\n"
) % (version,)
with open(out, "wb") as fh:
    fh.write(text.encode("iso8859-1"))
PCEOF
  [ -s "${ZOPEN_INSTALL_DIR}/lib/pkgconfig/blis.pc" ] || printError "could not write blis.pc"
  chtag -b "${ZOPEN_INSTALL_DIR}/lib/pkgconfig/blis.pc"

  # Assert it parses. A mis-encoded file is still a file, and the failure would
  # otherwise surface only in a consumer's build.
  PKG_CONFIG_PATH="${ZOPEN_INSTALL_DIR}/lib/pkgconfig" pkg-config --exists blis \
    || printError "the generated blis.pc is not readable by pkg-config"
}

zopen_append_to_env() {
cat <<ZZ
if [ ! -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
  export ZOPEN_EXTRA_CFLAGS="\${ZOPEN_EXTRA_CFLAGS} -I\$PWD/include"
  export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS}	-I\$PWD/include"
  export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\$PWD/lib"
  export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} -lblis"
fi
ZZ
}

